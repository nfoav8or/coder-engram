{
  "name": "coder-engram",
  "version": "0.13.0",
  "private": true,
  "description": "Give Claude Code safe, reviewable memory: agent-proposed entries you review before they land, stored as local Markdown.",
  "author": "Matt Smith",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "claude-code",
    "memory",
    "rag"
  ],
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "bench": "vitest run --config vitest.bench.config.ts tests/scale.bench.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "eval": "vitest run --config vitest.bench.config.ts tests/relevance.bench.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "obsidian": "^1.5.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
